---
import { cta } from '../data/site.js';
---
<section class="cta section" aria-labelledby="cta-title">
  <div class="cta__inner shell">
    <div class="cta__wash" aria-hidden="true"></div>
    <p class="label reveal">Get involved</p>
    <h2 class="cta__title display reveal" id="cta-title" data-reveal-delay="80">
      Build it, or help someone <em>else</em> build it.
    </h2>
    <p class="lead reveal" data-reveal-delay="140">
      Students apply to join the next sprint. Engineers, researchers, designers and
      founders sign up to mentor. Both take about three minutes.
    </p>
    <div class="cta__actions reveal" data-reveal-delay="200">
      <a class="btn btn--signal" href={cta.student.href}>{cta.student.label}</a>
      <a class="btn btn--ghost"  href={cta.mentor.href}>{cta.mentor.label}</a>
    </div>
  </div>
</section>

<style>
  .cta{ position:relative; overflow:hidden; }
  .cta__inner{
    position:relative;
    display:grid;
    gap:var(--s-5);
    justify-items:start;
  }
  .cta__wash{
    position:absolute;
    inset-block-start:-60%;
    inset-inline-start:-10%;
    inline-size:min(90vw, 900px);
    aspect-ratio:1;
    z-index:-1;
    background:radial-gradient(circle, oklch(76% 0.17 68 / 0.12), transparent 62%);
    filter:blur(24px);
    pointer-events:none;
  }
  .cta__title{
    font-size:var(--t-h1);
    line-height:var(--lh-tight);
    max-inline-size:16ch;
    text-wrap:balance;
  }
  .cta__title em{ font-style:italic; color:var(--signal-100); }
  .cta__actions{ display:flex; flex-wrap:wrap; gap:var(--s-3); margin-block-start:var(--s-3); }
</style>
