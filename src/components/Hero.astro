---
import { cta, stats } from '../data/site.js';
const rotating = JSON.stringify(['prompts', 'GPUs', 'benchmarks', 'compute', 'parameters']);
---

<section class="hero" aria-labelledby="hero-title">

  <!-- L0 atmosphere: a slow sodium wash. CSS-only, no WebGL payload
       standing between a first-time visitor and the headline. -->
  <div class="hero__wash" aria-hidden="true"></div>
  <div class="hero__horizon" aria-hidden="true"></div>

  <div class="hero__inner shell">

    <p class="hero__eyebrow label">
      <span class="hero__dot" aria-hidden="true"></span>
      Free · High school · Two days
    </p>

    <h1 class="hero__title display" id="hero-title" data-lines>
      <span>AI doesn't need better</span>
      <span><span class="rotor" data-rotate={rotating}>prompts</span>.</span>
      <span>It needs better <em>ideas</em>.</span>
    </h1>

    <p class="hero__lead lead">
      AIXelerate is a two-day build sprint for high schoolers. You bring a problem
      worth solving. We bring mentors, judges, compute, and a hard deadline.
      You leave with something that runs.
    </p>

    <div class="hero__actions">
      <a class="btn btn--signal" href={cta.student.href}>{cta.student.label}</a>
      <a class="btn btn--ghost"  href={cta.mentor.href}>{cta.mentor.label}</a>
    </div>

    <!-- Spec strip: the facts, set in mono, treated as instrumentation
         rather than marketing. -->
    <dl class="hero__spec">
      {stats.map((s) => (
        <div class="hero__spec-item">
          <dt class="label">{s.label}</dt>
          <dd class="hero__spec-value">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <a class="hero__scroll" href="#competition">
    <span class="label">Scroll</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero{
    position:relative;
    min-block-size:100svh;
    display:flex;
    align-items:flex-end;
    padding-block:calc(var(--nav-h, 76px) + var(--s-6)) var(--s-7);
    overflow:hidden;
    isolation:isolate;
  }

  /* ---------- Atmosphere ---------- */

  .hero__wash{
    position:absolute;
    inset-block-start:-30%;
    inset-inline-start:50%;
    inline-size:min(140vw, 1600px);
    aspect-ratio:1;
    translate:-50% 0;
    z-index:var(--z-base);
    background:radial-gradient(
      circle at 50% 45%,
      oklch(76% 0.17 68 / 0.16) 0%,
      oklch(70% 0.15 55 / 0.07) 32%,
      transparent 62%
    );
    filter:blur(30px);
    animation:hero-breathe 14s var(--e-inout) infinite;
  }
  @keyframes hero-breathe{
    0%,100%{ opacity:0.75; scale:1; }
    50%    { opacity:1;    scale:1.06; }
  }

  /* A single hairline horizon — the one piece of "instrument" chrome. */
  .hero__horizon{
    position:absolute;
    inset-block-end:0; inset-inline:0;
    block-size:1px;
    z-index:var(--z-base);
    background:linear-gradient(90deg,
      transparent, var(--signal-edge) 22%, var(--signal-edge) 78%, transparent);
  }

  .hero__inner{
    position:relative;
    z-index:var(--z-content);
    inline-size:100%;
    display:grid;
    gap:var(--s-5);
  }

  /* ---------- Eyebrow ---------- */

  .hero__eyebrow{
    display:flex;
    align-items:center;
    gap:var(--s-3);
    color:var(--ink-300);
  }
  .hero__dot{
    inline-size:6px; block-size:6px;
    border-radius:var(--r-pill);
    background:var(--signal-200);
    box-shadow:0 0 0 0 oklch(76% 0.17 68 / 0.6);
    animation:pulse 2.8s var(--e-out) infinite;
  }
  @keyframes pulse{
    0%  { box-shadow:0 0 0 0   oklch(76% 0.17 68 / 0.55); }
    70% { box-shadow:0 0 0 9px oklch(76% 0.17 68 / 0); }
    100%{ box-shadow:0 0 0 0   oklch(76% 0.17 68 / 0); }
  }

  /* ---------- Headline ---------- */

  .hero__title{
    /* The fluid scale is width-driven; on a short viewport that overshoots
       and pushes the spec strip below the fold. Cap against height too,
       with a floor so landscape phones do not collapse the headline. */
    font-size:max(2.75rem, min(var(--t-hero), 13.5vh));
    line-height:var(--lh-hero);
    max-inline-size:16ch;
    text-wrap:balance;
  }

  /* ---------- Lead + actions ---------- */

  .hero__lead{ max-inline-size:52ch; }

  .hero__actions{
    display:flex;
    flex-wrap:wrap;
    gap:var(--s-3);
    margin-block-start:var(--s-2);
  }

  /* ---------- Spec strip ---------- */

  .hero__spec{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:var(--s-5) var(--s-6);
    margin-block-start:var(--s-4);
    padding-block-start:var(--s-5);
    border-block-start:1px solid var(--rule-faint);
  }
  @media (min-width:720px){
    .hero__spec{ grid-template-columns:repeat(4, auto); justify-content:start; gap:var(--s-9); }
  }

  .hero__spec-item{ display:grid; gap:var(--s-2); }
  .hero__spec-value{
    font-family:var(--font-display);
    font-size:var(--t-h3);
    line-height:1;
    color:var(--ink-100);
    font-variant-numeric:tabular-nums;
  }

  /* ---------- Scroll cue ---------- */

  .hero__scroll{
    position:absolute;
    inset-block-end:var(--s-6);
    inset-inline-end:var(--s-gutter);
    z-index:var(--z-content);
    display:none;
    align-items:center;
    gap:var(--s-3);
    padding-block:var(--s-2);   /* clears the 24px minimum target size */
    color:var(--ink-400);
    transition:color var(--d-fast) var(--e-out);
  }
  @media (min-width:900px){ .hero__scroll{ display:flex; } }

  .hero__scroll:hover{ color:var(--signal-100); }
  .hero__scroll-line{
    inline-size:56px; block-size:1px;
    background:var(--rule-loud);
    position:relative;
    overflow:hidden;
  }
  .hero__scroll-line::after{
    content:'';
    position:absolute; inset-block:0; inset-inline-start:0;
    inline-size:40%;
    background:var(--signal-200);
    animation:scroll-sweep 2.6s var(--e-inout) infinite;
  }
  @keyframes scroll-sweep{
    0%  { transform:translateX(-100%); }
    100%{ transform:translateX(250%); }
  }

  @media (prefers-reduced-motion: reduce){
    .hero__wash, .hero__dot, .hero__scroll-line::after{ animation:none; }
  }
</style>
