---
import { cta } from '../data/site.js';
import SnailMark from './SnailMark.astro';

const tiles = [
  { src:'/images/aix3.jpg', cls:'t1' },
  { src:'/images/aix1.jpg', cls:'t2' },
  { src:'/images/aix4.jpg', cls:'t3' },
  { src:'/images/aix5.jpg', cls:'t4' },
  { src:'/images/conference.jpg', cls:'t5' },
  { src:'/images/aix2.jpg', cls:'t6' },
  { src:'/images/aix1.jpg', cls:'t7' },
  { src:'/images/aix4.jpg', cls:'t8' },
  { src:'/images/aix3.jpg', cls:'t9' },
  { src:'/images/aix5.jpg', cls:'t10' },
  { src:'/images/aix2.jpg', cls:'t11' },
];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__corners" aria-hidden="true"></div>
  <div class="hero__stage" data-hero-stage>
    <div class="hero__word hero__word--a"><h1 id="hero-title">AI</h1></div>
    <div class="hero__word hero__word--b" aria-hidden="true">XELERATE</div>

    <div class="hero__collage" aria-hidden="true" data-hero-stack>
      <div class="hero__signature"><SnailMark /></div>
      {tiles.map((tile) => <div class:list={['hero__tile', tile.cls]}><img src={tile.src} alt="" /></div>)}
    </div>

    <ul class="hero__list" aria-label="What the sprint is about">
      <li>Problem first</li><li>Build in public</li><li>Ship on Sunday</li>
    </ul>

    <div class="hero__meta">
      <p>Open to high school students</p>
      <p>Next date announcing soon</p>
      <p>$5,000+ raised / entry free</p>
    </div>

    <a class="hero__dock" href={cta.student.href}>
      <span class="hero__bubble">Got a rough idea?<br />That is enough.</span>
      <span class="hero__dock-icon"><SnailMark /></span>
      <span>Apply for the<br />next build sprint</span>
    </a>
  </div>

  <a class="hero__scroll" href="#studio"><i></i><span>Scroll</span></a>
  <p class="visually-hidden">AIXelerate is a free 48-hour AI build sprint for high school students.</p>
</section>

<style>
  .hero{ --pointer-x:50%; --pointer-y:50%; position:relative; min-height:100dvh; overflow:hidden; color:var(--ink-100); background:radial-gradient(circle at 50% 52%,oklch(24% .012 285 / .55),transparent 34%),var(--ground-000); isolation:isolate; }
  .hero::before{ content:''; position:absolute; inset:0; z-index:0; pointer-events:none; background:radial-gradient(circle 18rem at var(--pointer-x) var(--pointer-y),oklch(78% .17 68 / .075),transparent 72%); transition:opacity .4s; }
  .hero__stage{ position:absolute; inset:0; min-height:100dvh; will-change:transform,opacity,filter; }
  .hero::after{ content:''; position:absolute; inset:0; z-index:-1; pointer-events:none; background-image:radial-gradient(circle at center,oklch(100% 0 0 / .18) 0 1px,transparent 1.4px); background-size:17vw 19vh; mask-image:linear-gradient(to bottom,transparent,black 18%,black 80%,transparent); opacity:.22; }
  .hero__corners{ position:absolute; inset:6rem var(--s-gutter) 1.6rem; pointer-events:none; background:linear-gradient(var(--rule-loud),var(--rule-loud)) left top/18px 1px no-repeat,linear-gradient(var(--rule-loud),var(--rule-loud)) left top/1px 18px no-repeat,linear-gradient(var(--rule-loud),var(--rule-loud)) right bottom/18px 1px no-repeat,linear-gradient(var(--rule-loud),var(--rule-loud)) right bottom/1px 18px no-repeat; }
  .hero__word{ position:absolute; z-index:1; font-family:var(--font-display); font-size:var(--t-hero); font-weight:900; line-height:.76; letter-spacing:-.085em; }
  .hero__word--a{ left:var(--s-gutter); top:10.5%; }
  .hero__word--a h1{ margin:0; font:inherit; }
  .hero__word--b{ right:var(--s-gutter); bottom:9%; }

  .hero__collage{ position:absolute; z-index:2; left:50%; top:49%; width:min(44vw,560px); height:min(59vh,600px); transform:translate(-50%,-50%) rotateX(0) rotateY(0); transform-style:preserve-3d; perspective:1000px; transition:transform 160ms linear; }
  .hero__signature{ position:absolute; inset:5% 2%; z-index:0; color:var(--signal-100); opacity:.22; transform:translateZ(-60px) rotate(-8deg); filter:blur(.2px); }
  .hero__tile{ --mx:0px; --my:0px; --mr:0deg; --hover-z:0px; --z:0px; --r:0deg; position:absolute; width:24%; height:36%; overflow:hidden; border:1px solid oklch(100% 0 0 / .14); border-radius:clamp(7px,1vw,14px); background:var(--ground-100); box-shadow:var(--lift-3); transform:translate3d(var(--mx),var(--my),calc(var(--z) + var(--hover-z))) rotate(calc(var(--r) + var(--mr))); transform-style:preserve-3d; backface-visibility:hidden; will-change:transform; transition:border-color .3s,box-shadow .4s; }
  .hero__tile img{ width:100%; height:100%; object-fit:cover; filter:saturate(.72) contrast(1.07) brightness(.82); transition:transform .7s var(--e-entry),filter .45s var(--e-out); }
  .hero__tile:hover{ --hover-z:38px; z-index:30; border-color:var(--signal-edge); box-shadow:0 38px 90px -28px oklch(0% 0 0 / .95),0 0 0 1px var(--signal-edge); }
  .hero__tile:hover img{ transform:scale(1.09); filter:saturate(.95) contrast(1.04) brightness(.94); }
  .t1{ --z:-35px; --r:-3deg; left:2%; top:16%; width:24%; height:40%; z-index:3; }
  .t2{ --z:15px; --r:2deg; left:19%; top:2%; width:24%; height:38%; z-index:6; }
  .t3{ --z:55px; --r:-1deg; left:40%; top:0; width:26%; height:42%; z-index:9; }
  .t4{ --z:5px; --r:3deg; left:63%; top:10%; width:25%; height:40%; z-index:5; }
  .t5{ --z:-18px; --r:4deg; left:78%; top:30%; width:22%; height:36%; z-index:2; }
  .t6{ --z:-5px; --r:-4deg; left:0; top:52%; width:23%; height:37%; z-index:4; }
  .t7{ --z:75px; --r:2deg; left:17%; top:44%; width:28%; height:44%; z-index:10; }
  .t8{ --z:42px; --r:-3deg; left:44%; top:42%; width:27%; height:45%; z-index:8; }
  .t9{ --z:4px; --r:4deg; left:66%; top:48%; width:25%; height:40%; z-index:5; }
  .t10{ --z:25px; --r:-2deg; left:28%; top:72%; width:26%; height:30%; z-index:7; }
  .t11{ --z:-8px; --r:2deg; left:53%; top:74%; width:24%; height:28%; z-index:3; }

  .hero__list,.hero__meta{ position:absolute; z-index:3; list-style:none; padding:0; color:var(--ink-400); font-family:var(--font-mono); font-size:var(--t-micro); line-height:2.1; }
  .hero__list{ left:var(--s-gutter); bottom:8.5%; }
  .hero__meta{ right:var(--s-gutter); top:10%; text-align:right; }
  .hero__dock{ position:absolute; z-index:4; right:var(--s-gutter); bottom:30%; display:grid; grid-template-columns:46px auto; align-items:center; gap:.7rem; min-height:64px; padding:.45rem .8rem .45rem .45rem; border:1px solid var(--rule-faint); border-radius:14px; color:var(--ink-300); background:oklch(12% .006 285 / .72); box-shadow:var(--lift-2); backdrop-filter:blur(12px); font-family:var(--font-mono); font-size:.61rem; line-height:1.45; animation:dock-float 6.5s ease-in-out infinite; transition:border-color var(--d-fast) var(--e-out); }
  .hero__dock:hover{ transform:translateY(-3px); border-color:var(--signal-edge); }
  .hero__dock-icon{ width:46px; height:46px; padding:7px; border-radius:11px; color:var(--ground-000); background:var(--signal-100); }
  .hero__bubble{ position:absolute; left:-5.7rem; top:-2.45rem; padding:.48rem .65rem; border-radius:7px 7px 0 7px; color:var(--ink-100); background:var(--signal-300); white-space:nowrap; transform-origin:bottom right; animation:bubble-pop 8s var(--e-entry) 1.2s infinite both; }
  .hero__scroll{ position:absolute; z-index:3; left:50%; bottom:1.4rem; display:grid; justify-items:center; gap:.45rem; color:var(--ink-400); font-family:var(--font-mono); font-size:.55rem; letter-spacing:.28em; text-transform:uppercase; transform:translateX(-50%); }
  .hero__scroll i{ position:relative; width:1px; height:38px; overflow:hidden; background:var(--rule-loud); }
  .hero__scroll i::after{ content:''; position:absolute; inset:0; background:var(--ink-100); animation:cue-run 2.1s var(--e-inout) infinite; }
  @keyframes dock-float{ 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(-7px); } }
  @keyframes bubble-pop{ 0%,8%,86%,100%{ opacity:0; transform:scale(.72) translateY(7px); } 14%,78%{ opacity:1; transform:none; } }
  @keyframes cue-run{ 0%{ transform:translateY(-100%); } 55%,100%{ transform:translateY(100%); } }

  @media (max-width:900px){
    .hero__word--a{ top:14%; }
    .hero__word--b{ bottom:15%; font-size:clamp(4rem,16.5vw,8rem); }
    .hero__collage{ top:48%; width:min(72vw,520px); height:min(54vh,540px); }
    .hero__meta{ top:18%; }
    .hero__dock{ bottom:27%; }
  }
  @media (max-width:620px){
    .hero__corners{ top:5.2rem; }
    .hero__word{ font-size:clamp(4.4rem,24vw,7rem); }
    .hero__word--a{ top:15%; }
    .hero__word--b{ right:1rem; bottom:16%; font-size:clamp(3.1rem,16.7vw,5.2rem); }
    .hero__collage{ top:48%; width:88vw; height:48vh; }
    .hero__meta{ display:none; }
    .hero__list{ bottom:7.5rem; line-height:1.75; }
    .hero__dock{ right:1.2rem; bottom:24%; grid-template-columns:40px; padding:.35rem; }
    .hero__dock > span:last-child{ display:none; }
    .hero__dock-icon{ width:40px; height:40px; }
    .hero__bubble{ left:-6.1rem; top:-2.55rem; }
  }
  @media (prefers-reduced-motion:reduce){ .hero__collage{ transition:none; } }
</style>
