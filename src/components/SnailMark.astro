---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label } = Astro.props;
const uid = `snail-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  class={className}
  viewBox="0 0 680 520"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-body`} x1="80" y1="120" x2="620" y2="500" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="currentColor" stop-opacity=".08" />
      <stop offset=".5" stop-color="currentColor" stop-opacity=".22" />
      <stop offset="1" stop-color="currentColor" stop-opacity=".05" />
    </linearGradient>
    <linearGradient id={`${uid}-edge`} x1="150" y1="90" x2="555" y2="460" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="currentColor" stop-opacity=".92" />
      <stop offset=".48" stop-color="currentColor" stop-opacity=".34" />
      <stop offset="1" stop-color="currentColor" stop-opacity=".74" />
    </linearGradient>
    <filter id={`${uid}-soft`} x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="9" />
    </filter>
  </defs>

  <path
    d="M78 406c57-50 104-51 154-16 49 34 94 45 154 34 74-13 116-57 126-133 4-29-3-58 7-81 8-20 28-32 51-32 38 0 65 25 65 59 0 21-10 35-25 49v64c0 84-57 139-151 139H112c-43 0-67-18-67-43 0-15 11-30 33-40Z"
    fill={`url(#${uid}-body)`}
    stroke={`url(#${uid}-edge)`}
    stroke-width="3"
  />
  <path d="M536 187 514 104M594 181l19-83" fill="none" stroke={`url(#${uid}-edge)`} stroke-width="9" stroke-linecap="round" />
  <circle cx="511" cy="90" r="18" fill={`url(#${uid}-body)`} stroke={`url(#${uid}-edge)`} stroke-width="3" />
  <circle cx="617" cy="84" r="18" fill={`url(#${uid}-body)`} stroke={`url(#${uid}-edge)`} stroke-width="3" />

  <circle cx="284" cy="276" r="173" fill={`url(#${uid}-body)`} stroke={`url(#${uid}-edge)`} stroke-width="3" />
  <circle cx="284" cy="276" r="112" fill="none" stroke={`url(#${uid}-edge)`} stroke-width="22" stroke-opacity=".62" />
  <circle cx="284" cy="276" r="43" fill="none" stroke={`url(#${uid}-edge)`} stroke-width="16" stroke-opacity=".76" />

  <ellipse cx="305" cy="448" rx="218" ry="22" fill="currentColor" opacity=".12" filter={`url(#${uid}-soft)`} />
  <path d="M123 418c90 50 260 67 420 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".34" />
</svg>
