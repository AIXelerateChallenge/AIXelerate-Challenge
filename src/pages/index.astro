---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import SnailMark from '../components/SnailMark.astro';
import { site, stats } from '../data/site.js';

const moves = [
  { title:'Frame the problem', note:'Cut the idea until it can move.', image:'/images/aix3.jpg' },
  { title:'Find your team', note:'Match on curiosity, not credentials.', image:'/images/aix5.jpg' },
  { title:'Build with AI', note:'Put a rough prototype in someone’s hands.', image:'/images/aix1.jpg' },
  { title:'Test the impact', note:'Privacy, fairness, safety, and who is missing.', image:'/images/aix2.jpg' },
  { title:'Demo day', note:'Six minutes, a live demo, honest trade-offs.', image:'/images/aix4.jpg' },
];

const frames = [
  { n:'01', title:'The room', caption:'A deadline becomes useful when everyone can hear the clock.', image:'/images/aix2.jpg', pos:'50% 48%' },
  { n:'02', title:'The problem', caption:'Teams begin with a person and a friction point, not a model.', image:'/images/aix3.jpg', pos:'50% 46%' },
  { n:'03', title:'The build', caption:'Mentors work at the table. Nobody disappears into a lecture hall.', image:'/images/aix1.jpg', pos:'50% 43%' },
  { n:'04', title:'The review', caption:'Impact is interrogated while there is still time to change the prototype.', image:'/images/aix5.jpg', pos:'50% 42%' },
  { n:'05', title:'The demo', caption:'The prototype has to speak before the pitch can rescue it.', image:'/images/aix4.jpg', pos:'50% 46%' },
];

const phases = [
  { n:'01', time:'SAT / 09:00', title:'Interrogate', body:'Name the user, the friction, and the assumption most likely to be wrong.', list:['Problem framing','Team formation','Scope cut'] },
  { n:'02', time:'SAT / 12:00', title:'Prototype', body:'Make the smallest real thing that lets another person react honestly.', list:['Build track','Mentor rotations','User test'] },
  { n:'03', time:'SUN / 10:00', title:'Challenge', body:'Review privacy, fairness, safety, and what happens when the system fails.', list:['Impact review','Failure modes','Revision'] },
  { n:'04', time:'SUN / 15:00', title:'Present', body:'Show the working build, the trade-offs, and the next version you would make.', list:['Live demo','Six-minute pitch','Judge feedback'] },
];

const pathways = [
  {
    n:'01',
    type:'Coming next',
    title:'Online cohorts',
    body:'We are building guided online cohorts for students who cannot make it to an in-person sprint. Small teams, live mentor sessions, shared build hours, and a real demo at the end.',
    action:'Join the interest list',
    href:`mailto:${site.email}?subject=${encodeURIComponent('Online cohort interest')}`,
    featured:true,
  },
  {
    n:'02',
    type:'At your school',
    title:'Start a club',
    body:'Bring AIXelerate to your campus as a student-led club. We will help shape the format, build rhythm, and connect your group to the wider community.',
    action:'Start a school club',
    href:'https://discord.gg/VWRW4stAFu',
  },
  {
    n:'03',
    type:'In your city',
    title:'Host a hackathon',
    body:'Run a local build sprint under the AIXelerate name with our playbook, brand, and support—while your team makes it work for your community.',
    action:'Host with AIXelerate',
    href:'https://discord.gg/VWRW4stAFu',
  },
];
---

<Base title={site.name} description={site.tagline} transparentNav>
  <Hero />

  <section class="craft" id="studio" aria-labelledby="craft-title" data-craft>
    <div class="craft__pin">
      <div class="craft__intro shell">
        <h2 class="craft__statement" id="craft-title">We give high school students the room, people, and deadline to turn an AI idea into something another person can actually use.</h2>
      </div>
      <div class="craft__stage">
        <p class="craft__side craft__side--left">The sprint</p>
        <p class="craft__side craft__side--right">48 hours / all in</p>
        <div class="craft__wheel" data-craft-wheel aria-label="The five moves of an AIXelerate sprint">
          {moves.map((move, i) => (
            <article class="craft__row" data-craft-row={i}>
              <img src={move.image} alt="" width="96" height="96" loading="lazy" />
              <div><h3>{move.title}</h3><span class="visually-hidden">{move.note}</span></div>
            </article>
          ))}
        </div>
      </div>
      <dl class="craft__stats shell" aria-label="The people and support behind the sprint">
        <div class="craft__stat"><dt>Raised for the sprint</dt><dd>$5K<span>+</span></dd><p>Making the entire experience free.</p></div>
        <div class="craft__stat"><dt>Student sign-ups</dt><dd>80<span>+</span></dd><p>For our first build sprint.</p></div>
        <div class="craft__stat"><dt>Sponsors backing us</dt><dd>5</dd><p>Helping students turn ideas into builds.</p></div>
        <div class="craft__stat craft__stat--speakers"><dt>Coming to speak</dt><dd>Industry<br />professionals<span aria-hidden="true">↗</span></dd><p>Real experience. Fresh perspectives.</p></div>
      </dl>
    </div>
  </section>

  <section class="field" id="work" aria-labelledby="field-title" data-field>
    <div class="field__pin">
      <div class="field__top">
        <h2 id="field-title">What building looked like</h2>
        <p>July 2026 <span aria-hidden="true">/</span> Five moments</p>
      </div>
      <div class="field__deck">
        {frames.map((frame, i) => (
          <article class:list={['field__card', { 'is-active': i === 0 }]} data-field-card={i}>
            <img src={frame.image} alt={frame.caption} loading={i === 0 ? 'eager' : 'lazy'} style={`object-position:${frame.pos}`} />
            <div class="field__shade"></div>
            <p class="field__number">{frame.n} / {String(frames.length).padStart(2, '0')}</p>
            <h3>{frame.title}</h3>
            <p class="field__caption">{frame.caption}</p>
          </article>
        ))}
      </div>
      <div class="field__rail" aria-hidden="true">
        <div class="field__index"><span data-field-index>01</span><span class="field__total">/{String(frames.length).padStart(2, '0')}</span></div>
        <i class="field__progress"><b data-field-progress></b></i>
        <div class="field__detail"><p data-field-name>{frames[0].title}</p><p data-field-caption>{frames[0].caption}</p></div>
      </div>
    </div>
  </section>

  <section class="signature" aria-labelledby="signature-title">
    <div class="signature__stage">
      <p class="signature__badge signature__badge--a">AIX / signature</p>
      <p class="signature__badge signature__badge--b">Working object / live</p>
      <div class="signature__object" aria-hidden="true"><SnailMark /></div>
      <h2 class="visually-hidden" id="signature-title">A working prototype is the signature of every team.</h2>
      <p class="signature__copy" data-wordwash>Every team leaves with a signature object: a working prototype that catches feedback, exposes assumptions, and belongs to the people who built it.</p>
    </div>
  </section>

  <section class="process" id="process" aria-labelledby="process-title" data-process>
    <div class="process__pin">
      <div class="process__head shell">
        <div><p>The 48 hours</p><h2 id="process-title">Four moves,<br />no theatre.</h2></div>
        <p>Students see something real on Saturday, not a polished deck on Sunday.</p>
      </div>
      <div class="process__viewport">
        <div class="process__track" data-process-track>
          {phases.map((phase) => (
            <article class="phase">
              <p class="phase__meta">{phase.n} / {phase.time}</p>
              <h3>{phase.title}</h3>
              <i aria-hidden="true"><b></b></i>
              <p>{phase.body}</p>
              <ul>{phase.list.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
      <div class="process__progress"><i data-process-progress></i></div>
    </div>
  </section>

  <section class="network section" id="network" aria-labelledby="network-title">
    <div class="network__head shell">
      <p class="network__eyebrow reveal">Beyond one weekend / what comes next</p>
      <h2 class="reveal" id="network-title">One room becomes<br /><em>a network.</em></h2>
      <p class="network__intro reveal" data-reveal-delay="80">AIXelerate is growing into a format students can join online, bring to school, or host in their own community.</p>
    </div>
    <div class="network__grid shell">
      {pathways.map((pathway, i) => (
        <article class:list={['network__card', { 'network__card--featured': pathway.featured }, 'reveal']} data-reveal-delay={i * 80} data-pathway-card>
          <div class="network__meta"><span>{pathway.n}</span><span>{pathway.type}</span></div>
          <h3>{pathway.title}</h3>
          <p>{pathway.body}</p>
          <a href={pathway.href}>{pathway.action}<span aria-hidden="true">↗</span></a>
          <i aria-hidden="true"></i>
        </article>
      ))}
    </div>
    <p class="network__contact shell reveal">Have a different idea? <a href={`mailto:${site.email}?subject=${encodeURIComponent('Build with AIXelerate')}`}>Talk directly with the team ↗</a></p>
  </section>

  <section class="proof section" aria-labelledby="proof-title">
    <div class="proof__head shell">
      <div><p>First sprint / July 2026</p><h2 id="proof-title">One month to fill a room.</h2></div>
      <p>The first cohort proved the premise: when cost disappears and the standard stays high, students show up ready to build.</p>
    </div>
    <div class="proof__image reveal"><img src="/images/conference.jpg" alt="Four AIXelerate students standing together after the event." loading="lazy" /></div>
    <dl class="proof__stats shell">
      {stats.map((stat, i) => (
        <div class="proof__stat reveal" data-reveal-delay={i * 70}>
          <dt>{stat.label}</dt><dd data-count={stat.count} data-prefix={stat.prefix} data-suffix={stat.suffix}>{stat.value}</dd><p>{stat.note}</p>
        </div>
      ))}
    </dl>
  </section>

  <CTA />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = window.matchMedia('(min-width: 820px)').matches;

    gsap.registerPlugin(ScrollTrigger);
    const craftMedia = gsap.matchMedia();
    craftMedia.add('(min-width: 820px) and (min-height: 650px) and (prefers-reduced-motion: no-preference)', () => {
      const craft = document.querySelector('[data-craft]');
      const wheel = document.querySelector('[data-craft-wheel]');
      if (!craft || !wheel) return;
      const originals = [...wheel.querySelectorAll('[data-craft-row]')];
      const clones = [];
      // A larger ring keeps neighboring words nearly face-on, like the reference.
      for (let copy = 0; copy < 3; copy++) {
        originals.forEach(row => {
          const clone = row.cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          clone.removeAttribute('data-craft-row');
          wheel.appendChild(clone);
          clones.push(clone);
        });
      }
      craft.classList.add('is-animated');
      const rows = [...wheel.querySelectorAll('.craft__row')];
      const step = 360 / rows.length;
      const state = { angle: step * 2 };
      let radius = 300;
      const render = () => {
        rows.forEach((row, index) => {
          const delta = ((index * step - state.angle) % 360 + 540) % 360 - 180;
          const radians = delta * Math.PI / 180;
          const face = Math.cos(radians);
          const y = Math.sin(radians) * radius;
          const z = (face - 1) * radius;
          row.style.transform = `translate(-50%, -50%) translate3d(0, ${y}px, ${z}px) rotateX(${-delta}deg)`;
          row.style.opacity = String(Math.max(0, Math.min(1, (face - .25) / .75)));
          row.classList.toggle('is-facing', Math.abs(delta) < step * .5);
        });
      };
      const resize = () => {
        const rowHeight = originals[0].getBoundingClientRect().height;
        const titleSize = parseFloat(getComputedStyle(originals[0].querySelector('h3')).fontSize);
        const gap = Math.max(titleSize * 1.15, Math.min(rowHeight, 120));
        radius = gap / Math.sin(step * Math.PI / 180);
        render();
      };
      resize();
      window.addEventListener('resize', resize, { passive:true });
      gsap.to(state, {
        angle: step * 7,
        ease:'none',
        onUpdate:render,
        scrollTrigger:{ trigger:craft, start:'top top', end:'bottom bottom', scrub:.4, invalidateOnRefresh:true },
      });
      return () => {
        window.removeEventListener('resize', resize);
        clones.forEach(clone => clone.remove());
        originals.forEach(row => { row.removeAttribute('style'); row.classList.remove('is-facing'); });
        craft.classList.remove('is-animated');
      };
    });

    const fieldMedia = gsap.matchMedia();
    fieldMedia.add('(min-width: 820px) and (min-height: 600px) and (prefers-reduced-motion: no-preference)', () => {
      const field = document.querySelector('[data-field]');
      const deck = field?.querySelector('.field__deck');
      const cards = [...document.querySelectorAll('[data-field-card]')];
      const index = document.querySelector('[data-field-index]');
      const name = document.querySelector('[data-field-name]');
      const caption = document.querySelector('[data-field-caption]');
      const progress = document.querySelector('[data-field-progress]');
      if (!field || !deck || !cards.length) return;

      field.classList.add('is-animated');
      const state = { position:0 };
      let cardSize = deck.clientWidth;
      let shown = -1;
      const render = () => {
        const position = state.position;
        const front = Math.min(cards.length - 1, Math.floor(position + .5));
        // The fan spans the stage; its last photograph settles at the center.
        const remaining = 1 - position / (cards.length - 1);
        cards.forEach((card, i) => {
          const delta = i - position;
          const depth = Math.max(0, delta);
          const passed = Math.max(0, -delta);
          const x = -cardSize * .22 * remaining + depth * cardSize * .21 - passed * cardSize * .9;
          const y = -cardSize * .07 * remaining + depth * cardSize * .09 - passed * cardSize * .48;
          const rotation = -10 * remaining + depth * 3 - passed * 18;
          const scale = delta < 0 ? 1 + passed * .12 : 1 - depth * .065;
          const opacity = delta < 0 ? Math.max(0, 1 - passed * 1.25) : 1 - depth * .12;
          card.style.zIndex = String(cards.length - i);
          card.style.opacity = String(opacity);
          card.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0) rotate(${rotation.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
          card.classList.toggle('is-active', i === front);
        });
        progress.style.transform = `scaleX(${(position + 1) / cards.length})`;
        if (front !== shown) {
          shown = front;
          index.textContent = String(front + 1).padStart(2, '0');
          name.textContent = cards[front].querySelector('h3').textContent;
          caption.textContent = cards[front].querySelector('.field__caption').textContent;
        }
      };
      const resize = () => { cardSize = deck.clientWidth; render(); };
      render();
      window.addEventListener('resize', resize, { passive:true });
      // Hold each frame briefly, including the final one, so every photo can be read.
      const timeline = gsap.timeline({
        scrollTrigger:{ trigger:field, start:'top top', end:'bottom bottom', scrub:.45, invalidateOnRefresh:true },
      });
      cards.slice(1).forEach((_, i) => {
        timeline.to(state, { position:i + 1, duration:.7, ease:'power2.inOut', onUpdate:render }, i + .3);
      });
      timeline.to(state, { duration:.3 });
      return () => {
        window.removeEventListener('resize', resize);
        field.classList.remove('is-animated');
        cards.forEach((card, i) => {
          card.removeAttribute('style');
          card.classList.toggle('is-active', i === 0);
        });
        progress.style.removeProperty('transform');
      };
    });

    if (!reduced && wide) {
      const process = document.querySelector('[data-process]');
      const track = document.querySelector('[data-process-track]');
      const processProgress = document.querySelector('[data-process-progress]');
      if (process && track) {
        const distance = () => Math.max(0, track.scrollWidth - window.innerWidth + window.innerWidth * .08);
        gsap.to(track, {
          x:() => -distance(), ease:'none',
          scrollTrigger:{ trigger:process, start:'top top', end:() => `+=${distance()}`, pin:process.querySelector('.process__pin'), scrub:.45, invalidateOnRefresh:true, anticipatePin:1, onUpdate:(self) => { processProgress.style.transform = `scaleX(${self.progress})`; } },
        });
      }

      document.querySelectorAll('[data-wordwash]').forEach((block) => {
        const words = block.textContent.trim().split(/\s+/);
        block.textContent = '';
        words.forEach((word, i) => {
          const span = document.createElement('span');
          span.textContent = word;
          block.appendChild(span);
          if (i < words.length - 1) block.append(' ');
        });
        gsap.to(block.querySelectorAll('span'), {
          color:'var(--ink-200)',
          stagger:.04,
          ease:'none',
          scrollTrigger:{ trigger:block, start:'top 84%', end:'top 34%', scrub:true },
        });
      });

      document.querySelectorAll('[data-count]').forEach((number) => {
        const target = Number(number.dataset.count || 0);
        const prefix = number.dataset.prefix || '';
        const suffix = number.dataset.suffix || '';
        const counter = { value:0 };
        gsap.to(counter, {
          value:target,
          duration:1.5,
          ease:'power3.out',
          onUpdate:() => { number.textContent = `${prefix}${Math.round(counter.value).toLocaleString('en-US')}${suffix}`; },
          scrollTrigger:{ trigger:number, start:'top 88%', once:true },
        });
      });

      document.querySelectorAll('[data-pathway-card]').forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const rect = card.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - .5;
          const y = (event.clientY - rect.top) / rect.height - .5;
          card.style.transform = `perspective(1200px) rotateX(${y * -4.5}deg) rotateY(${x * 5.5}deg) translateY(-4px)`;
        }, { passive:true });
        card.addEventListener('pointerleave', () => {
          card.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg)';
        });
      });
    }
  </script>
</Base>

<style>
  .craft{ position:relative; background:var(--ground-000); padding-block:6rem 3rem; }
  .craft__pin{ position:relative; }
  .craft__intro{ padding-block:1.5rem 2.5rem; text-align:center; }
  .craft__statement{ max-width:45ch; margin-inline:auto; color:var(--ink-300); font-family:var(--font-mono); font-size:clamp(.85rem,1.15vw,1.25rem); font-weight:400; line-height:1.65; }
  .craft__stage{ position:relative; }
  .craft__side{ display:none; }
  .craft__wheel{ width:100%; max-width:1440px; margin-inline:auto; padding-inline:var(--s-gutter); }
  .craft__row{ display:flex; align-items:center; justify-content:center; gap:clamp(.7rem,1.5vw,1.7rem); padding-block:.8rem; }
  .craft__row img{ flex:none; width:clamp(48px,5.3vw,96px); aspect-ratio:1; height:auto; object-fit:cover; object-position:50% 42%; border-radius:15%; }
  .craft__row > div{ min-width:0; }
  .craft__row h3{ color:var(--signal-300); font-size:clamp(1.25rem,5.7vw,7.2rem); font-weight:850; line-height:.98; letter-spacing:-.045em; text-transform:uppercase; }
  .craft__row:nth-child(3) h3{ color:var(--ink-100); }
  .craft__stats{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; margin-top:2rem; }
  .craft__stat{ position:relative; display:flex; flex-direction:column; align-items:flex-start; min-height:clamp(150px,12vw,205px); padding:clamp(1rem,1.6vw,1.8rem); border:1px solid var(--rule-loud); border-radius:18px; background:linear-gradient(160deg,oklch(24% .008 285),oklch(17% .006 285)); box-shadow:inset 0 1px 0 oklch(96% .009 92 / .06); }
  .craft__stat::after{ content:'···'; position:absolute; top:8px; right:17px; color:var(--ink-400); font-size:18px; letter-spacing:3px; }
  .craft__stat dt{ margin-bottom:1rem; padding-right:.5rem; color:var(--ink-300); font-family:var(--font-mono); font-size:clamp(.58rem,.72vw,.78rem); letter-spacing:.06em; text-transform:uppercase; }
  .craft__stat dd{ color:var(--ink-100); font-size:clamp(2.8rem,4.5vw,5.3rem); font-weight:800; line-height:1; letter-spacing:-.055em; }
  .craft__stat dd>span{ color:var(--signal-100); }
  .craft__stat p{ margin-top:auto; padding-top:.75rem; color:var(--ink-300); font-size:clamp(.65rem,.78vw,.85rem); line-height:1.45; }
  .craft__stat--speakers dd{ position:relative; font-size:clamp(1.2rem,2.1vw,2.5rem); line-height:1.1; letter-spacing:-.035em; }
  .craft__stat--speakers dd>span{ position:absolute; top:0; right:-1.3em; font-size:.7em; }
  @media(min-width:820px) and (min-height:650px) and (prefers-reduced-motion:no-preference){
    .craft.is-animated{ height:240svh; padding-block:0; }
    .craft.is-animated .craft__pin{ position:sticky; top:0; height:100svh; display:grid; grid-template-rows:auto minmax(0,1fr) auto; padding-block:clamp(80px,10svh,120px) 24px; overflow:hidden; }
    .craft.is-animated .craft__intro{ padding-block:0 20px; z-index:2; }
    .craft.is-animated .craft__stage{ min-height:0; overflow:hidden; perspective:1400px; }
    .craft.is-animated .craft__stage::before,.craft.is-animated .craft__stage::after{ content:''; position:absolute; left:0; right:0; height:25%; z-index:2; pointer-events:none; }
    .craft.is-animated .craft__stage::before{ top:0; background:linear-gradient(var(--ground-000),transparent); }
    .craft.is-animated .craft__stage::after{ bottom:0; background:linear-gradient(transparent,var(--ground-000)); }
    .craft.is-animated .craft__wheel{ position:absolute; inset:0; padding:0; transform-style:preserve-3d; }
    .craft.is-animated .craft__row{ position:absolute; top:50%; left:50%; width:100%; padding:0; backface-visibility:hidden; transform-style:preserve-3d; }
    .craft.is-animated .craft__row h3{ white-space:nowrap; color:var(--signal-300); transition:color .2s linear; }
    .craft.is-animated .craft__row.is-facing h3{ color:var(--ink-100); }
    .craft.is-animated .craft__side{ display:block; position:absolute; z-index:3; top:50%; transform:translateY(-50%); color:var(--ink-300); font-family:var(--font-mono); font-size:var(--t-micro); letter-spacing:.08em; text-transform:uppercase; }
    .craft.is-animated .craft__side--left{ left:var(--s-gutter); color:var(--signal-300); text-decoration:line-through; text-decoration-thickness:1px; }
    .craft.is-animated .craft__side--right{ right:var(--s-gutter); }
    .craft.is-animated .craft__stats{ margin-top:15px; position:relative; z-index:3; }
  }
  @media(min-width:820px) and (max-width:1150px){ .craft.is-animated .craft__side{ display:none; } }
  @media(max-width:819px){
    .craft__stats{ grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; }
    .craft__row{ justify-content:flex-start; border-top:1px solid var(--rule); padding-block:1.3rem; }
    .craft__row h3{ font-size:clamp(1.3rem,4.6vw,2.7rem); }
    .craft__stat{ min-height:165px; border-radius:12px; }
    .craft__stat--speakers dd{ font-size:clamp(1.2rem,3.3vw,1.8rem); }
    .craft__stat--speakers dd>span{ display:none; }
    .craft__statement{ max-width:43ch; }
  }

  .field{ position:relative; padding-block:6rem; background:var(--ground-000); }
  .field__pin{ position:relative; }
