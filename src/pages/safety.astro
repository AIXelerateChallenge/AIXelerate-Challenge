---
import Base from '../layouts/Base.astro';
import sections from '../data/safeguarding-policy.json';

const pdfHref = '/documents/aixelerate-youth-safety-safeguarding-policy.pdf';
---

<Base title="Youth Safety & Safeguarding Policy" description="Read AIXelerate's youth safety and safeguarding policy online or download the PDF. Reporting contact details are pending.">
  <article class="policy shell shell--narrow" aria-labelledby="policy-title">
    <header class="policy__header">
      <p class="label">AIXelerate Challenge / Youth safety</p>
      <h1 id="policy-title">Youth Safety &amp; Safeguarding Policy</h1>
      <p class="policy__owner">Policy owner: AIXelerate Leadership and Board</p>
      <dl class="policy__meta">
        <div><dt>Version</dt><dd>1.0</dd></div>
        <div><dt>Date approved</dt><dd><time datetime="2026-10-03">October 3, 2026</time></dd></div>
        <div><dt>Next review</dt><dd><time datetime="2028-10-03">October 3, 2028</time></dd></div>
      </dl>
      <div class="policy__notice" aria-labelledby="contacts-pending">
        <h2 id="contacts-pending">Reporting contact details are pending</h2>
        <p>The supplied policy still contains placeholders for the primary and secondary safeguarding contacts and the reporting email in <a href="#section-7">section 7</a> and <a href="#section-15">section 15</a>. Those details need to be completed and confirmed with the fiscal sponsor before this policy can provide a usable reporting route.</p>
        <p>If the situation presents an immediate danger, contact emergency services or the appropriate emergency authority first.</p>
      </div>
      <div class="policy__actions">
        <a class="btn btn--signal" href={pdfHref}>Open PDF</a>
        <a class="btn btn--ghost" href={pdfHref} download="AIXelerate-Youth-Safety-Safeguarding-Policy.pdf">Download PDF</a>
        <span>12 pages · 160 KB</span>
      </div>
      <p class="policy__source">The policy text below reproduces the supplied version 1.0 PDF. Its contact placeholders and signed acknowledgment are retained as written.</p>
    </header>

    <details class="policy__contents">
      <summary>Browse policy sections</summary>
      <nav aria-label="Policy contents">
        <ul>{sections.map((section) => <li><a href={`#${section.id}`}>{section.title}</a></li>)}</ul>
      </nav>
    </details>

    <div class="policy__text">
      {sections.map((section) => (
        <section id={section.id} aria-labelledby={`${section.id}-title`}>
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          {section.blocks.map((block) => (
            block.type === 'heading' ? <h3>{block.text}</h3> :
            block.type === 'ul' ? <ul>{block.items?.map((item) => <li>{item}</li>)}</ul> :
            block.type === 'ol' ? <ol>{block.items?.map((item) => <li>{item}</li>)}</ol> :
            block.type === 'lines' ? <p>{block.lines?.map((line) => <span class="policy__line">{line}</span>)}</p> :
            <p>{block.text}</p>
          ))}
        </section>
      ))}
    </div>
    <a class="policy__top" href="#policy-title">Back to top ↑</a>
  </article>
</Base>

<style>
  .policy{ padding-block:clamp(7rem,12vw,10rem) 5rem; }
  .policy__header{ display:grid; gap:1.5rem; }
  h1{ max-width:20ch; color:var(--brand-orange); font-size:clamp(2rem,5.5vw,4.5rem); line-height:1.1; text-wrap:balance; }
  .policy__owner,.policy__source{ color:var(--ink-300); }
  .policy__meta{ display:flex; flex-wrap:wrap; gap:1rem 3rem; padding-block:1.25rem; border-block:1px solid var(--rule); }
  .policy__meta dt{ color:var(--ink-400); font-size:var(--t-small); }
  .policy__meta dd{ margin-top:.25rem; font-weight:600; }
  .policy__notice{ padding:clamp(1rem,3vw,1.5rem); border:1px solid var(--signal-edge); border-radius:var(--r-soft); background:var(--brand-white); }
  .policy__notice h2{ font-size:clamp(1.1rem,2.5vw,1.4rem); line-height:1.3; }
  .policy__notice p{ margin-top:1rem; }
  .policy a:not(.btn){ text-decoration:underline; text-underline-offset:.2em; }
  .policy__actions{ display:flex; align-items:center; flex-wrap:wrap; gap:1rem; }
  .policy__actions span,.policy__source{ font-size:var(--t-small); }
  .policy__contents{ margin-block:2rem 3rem; padding:1rem 1.25rem; border:1px solid var(--rule); border-radius:var(--r-soft); }
  .policy__contents summary{ cursor:pointer; padding-block:.5rem; font-weight:600; }
  .policy__contents ul{ list-style:none; padding:1rem 0 0; }
  .policy__contents a{ display:block; padding:.5rem 0; }
  .policy__text{ max-width:70ch; }
  .policy__text section{ margin-top:3rem; padding-top:1.5rem; border-top:1px solid var(--rule); }
  .policy__text h2{ margin-bottom:1.5rem; font-size:clamp(1.3rem,3vw,2rem); line-height:1.3; text-wrap:balance; }
  .policy__text h3{ margin-block:1.5rem .75rem; font-size:1.1rem; }
  .policy__text p,.policy__text ul,.policy__text ol{ margin-block:1rem; }
  .policy__text ul,.policy__text ol{ padding-left:1.5rem; }
  .policy__text li + li{ margin-top:.5rem; }
  .policy__line{ display:block; }
  .policy__text p,.policy__text li{ overflow-wrap:anywhere; text-wrap:pretty; }
  .policy__top{ display:inline-block; margin-top:2rem; padding-block:.75rem; }
  [id]{ scroll-margin-top:5rem; }
  @media print{
    :global(.nav),:global(.foot),:global(.grain),:global(.skip-link),.policy__actions,.policy__contents,.policy__top{ display:none !important; }
    .policy{ max-width:none; padding:0; color:#000; }
    .policy__text{ max-width:none; }
    h1{ color:#000; font-size:24pt; }
    .policy__text h2{ font-size:16pt; }
    h1,h2,h3{ break-after:avoid; }
    .policy__notice{ break-inside:avoid; }
  }
</style>
